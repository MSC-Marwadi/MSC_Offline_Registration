# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/msc_26-08-2026_event_db?schema=public"

# Admin Auth & JWT
JWT_SECRET=super-secret-msc-event-key-change-in-production
SESSION_SECRET=super-secret-session-key

# Email Configuration (Gmail SMTP)
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME="MSC Event Team"

# Confirmation Deadlines Configuration
DEFAULT_INITIAL_DEADLINE_HOURS=24
DEFAULT_QUEUE_DEADLINE_HOURS=1
