generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMATION_PENDING
  CONFIRMED
  QUEUED
  PROMOTED
  CANCELLED
  EXPIRED
  REJECTED
  PRESENT
}

enum TokenResponseStatus {
  PENDING
  YES
  NO
  EXPIRED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model EventConfig {
  id                           String   @id @default(cuid())
  name                         String   @default("MSC Annual Tech Symposium 2026")
  description                  String   @default("The flagship annual technology and innovation symposium featuring industry leaders, hands-on workshops, and tech showcases.")
  eventDate                    DateTime @default(now())
  venue                        String   @default("Main University Auditorium & Online Stream")
  totalCapacity                Int      @default(100)
  confirmationWindowHours      Int      @default(1)
  queueConfirmationWindowHours Int      @default(1)
  registrationOpen             Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model Registration {
  id                   String             @id @default(cuid())
  fullName             String
  email                String             @unique
  enrollmentNumber     String             @unique
  grNumber             String             @unique
  department           String
  additionalInfo       String?
  phone                String?            @default("N/A")
  college              String?            @default("Marwadi University")
  course               String?            @default("Computer Science / IT")
  semester             String?            @default("N/A")
  division             String?            @default("N/A")
  status               RegistrationStatus @default(REGISTERED)
  queuePosition        Int?
  confirmationDeadline DateTime?
  uniqueId             String?            @unique
  qrCodeToken          String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  confirmationTokens ConfirmationToken[]
  attendance         Attendance?
  auditLogs          AuditLog[]
  emailJobs          EmailJob[]

  @@index([email])
  @@index([enrollmentNumber])
  @@index([grNumber])
  @@index([uniqueId])
  @@index([status])
  @@index([queuePosition])
  @@index([confirmationDeadline])
}

model ConfirmationToken {
  id             String              @id @default(cuid())
  registrationId String
  token          String              @unique
  responseStatus TokenResponseStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([registrationId])
}

model Attendance {
  id             String   @id @default(cuid())
  registrationId String   @unique
  scannedAt      DateTime @default(now())
  scannedBy      String
  method         String   @default("QR_SCAN")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model EmailJob {
  id             String         @id @default(cuid())
  registrationId String?
  emailType      String
  recipient      String
  subject        String
  status         EmailJobStatus @default(PENDING)
  retries        Int            @default(0)
  payload        String
  errorMessage   String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([idempotencyKey])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  registrationId String?
  adminId        String?
  metadata       String?
  timestamp      DateTime @default(now())

  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([timestamp])
}
